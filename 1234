                    if GetRoot(Plr).Parent.Humanoid.RigType.Name == "R15" and GetRoot(Plr).Parent.Humanoid.Sit then 
                        if not CheckAnim("5918726674") then PlayAnim(5918726674, 0, tonumber(getgenv().ConfigData.BangSpeed)) end 
